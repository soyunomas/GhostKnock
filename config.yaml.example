# ==============================================================================
# GHOSTKNOCK v2.1.0 - Archivo de Configuración Maestro (Referencia Completa)
# ==============================================================================
# Este archivo documenta TODAS las opciones de configuración disponibles.
#
# INSTRUCCIONES BÁSICAS:
# 1. Copie este archivo: sudo cp config.yaml.example /etc/ghostknock/config.yaml
# 2. Asegure permisos:   sudo chmod 600 /etc/ghostknock/config.yaml
# 3. Reinicie servicio:  sudo systemctl restart ghostknockd
# ==============================================================================

# [OBLIGATORIO] Ruta a la clave privada del servidor (generada con ghostknock-keygen -o server_key).
# El servidor necesita esto para descifrar los paquetes entrantes.
server_private_key_path: "/etc/ghostknock/server_key"

# ------------------------------------------------------------------------------
# 1. CONFIGURACIÓN DEL LISTENER (RED)
# ------------------------------------------------------------------------------
listener:
  # [OBLIGATORIO] Interfaz de red donde se escuchará el tráfico.
  # Use "any" para escuchar en todas, o el nombre específico (ej. "eth0", "ens192").
  # RECOMENDACIÓN: Usar la interfaz específica reduce la superficie de ataque.
  interface: "any"

  # [OBLIGATORIO] Puerto UDP a monitorizar.
  # GhostKnock NO responde en este puerto (es silencioso/stealth).
  port: 3001

  # [OPCIONAL] IP específica donde escuchar dentro de la interfaz.
  # Si se omite, escucha en todas las IPs de la interfaz seleccionada.
  # listen_ip: "203.0.113.10"

# ------------------------------------------------------------------------------
# 2. LOGGING (REGISTROS)
# ------------------------------------------------------------------------------
logging:
  # Nivel de detalle del log.
  # Opciones: "debug" (máximo detalle), "info" (recomendado), "warn", "error".
  log_level: "info"

  # Destino del log.
  # Opciones:
  #   - "/ruta/archivo.log": Escribe en disco.
  #   - "stdout": Escribe en salida estándar (ideal para Docker/Systemd journal).
  #   - "/dev/null": Desactiva el logging.
  log_file: "/var/log/ghostknockd.log"

  # Formato de salida.
  # Opciones:
  #   - "text": Formato legible por humanos (Key=Value).
  #   - "json": Formato estructurado JSON (ideal para ELK, Datadog, Splunk).
  log_format: "text"

# ------------------------------------------------------------------------------
# 3. DAEMON (CONFIGURACIÓN DEL PROCESO)
# ------------------------------------------------------------------------------
daemon:
  # Ruta para escribir el PID del proceso (útil para monitoreo).
  pid_file: "/var/run/ghostknockd.pid"

  # [AVANZADO] Intérprete de comandos (Shell) a utilizar.
  # Por defecto: "/bin/sh" con flag "-c".
  # Puede cambiarlo si usa un sistema minimalista (Alpine -> /bin/ash)
  # o si desea restringir la ejecución (ej. /bin/rbash).
  shell_path: "/bin/sh"
  shell_flag: "-c"

# ------------------------------------------------------------------------------
# 4. TUNING (RENDIMIENTO Y GESTIÓN DE RECURSOS)
# ------------------------------------------------------------------------------
# Estas opciones permiten ajustar el comportamiento interno para escalar desde
# una Raspberry Pi hasta servidores Enterprise con tráfico masivo.
tuning:
  # Tamaño del buffer del canal de paquetes (en número de paquetes).
  # Si el servidor recibe una ráfaga masiva, este buffer absorbe el pico.
  # Si se llena, los paquetes se descartan (Fail-Fast).
  # Requiere reinicio del servicio (systemctl restart).
  packet_channel_buffer: 100

  # Timeout de lectura del listener nativo (en milisegundos).
  # El nombre pcap_timeout_ms se mantiene por compatibilidad.
  # Menor valor = Menor latencia, mayor uso de CPU.
  # Mayor valor = Mayor latencia, menor uso de CPU.
  # Requiere reinicio del servicio.
  pcap_timeout_ms: 300

  # --- GESTIÓN DE MEMORIA (ANTI-OOM) ---
  
  # Número máximo de IPs rastreadas simultáneamente para Rate Limiting.
  # Protege la memoria RAM contra ataques que usan millones de IPs spoofeadas.
  max_tracked_ips: 20000

  # Cantidad de IPs a purgar de golpe cuando la tabla se llena (max_tracked_ips).
  eviction_batch_size: 2000

  # Intervalo (segundos) para el recolector de basura de la caché de firmas (Anti-Replay).
  cache_cleanup_seconds: 60

  # Intervalo (segundos) para el recolector de basura de limitadores de IP.
  limiter_cleanup_seconds: 180

  # Tiempo de inactividad (segundos) tras el cual se olvida una IP en el Rate Limiter.
  limiter_eviction_age_seconds: 300

# ------------------------------------------------------------------------------
# 5. SEGURIDAD
# ------------------------------------------------------------------------------
security:
  # Ventana temporal simétrica para prevenir ataques de repetición.
  # Se rechazan timestamps anteriores a now-X y posteriores a now+X segundos.
  # Rango válido: 1-3600. Requiere NTP y reiniciar el daemon para cambiarla.
  replay_window_seconds: 5

  # Tiempo de espera por defecto (segundos) entre ejecuciones de acciones.
  # Se aplica si una acción no define su propio 'cooldown_seconds'.
  default_action_cooldown_seconds: 15

  # --- ANTI-DOS (RATE LIMITING) ---
  # Límite de paquetes procesados por segundo desde una misma IP.
  rate_limit_per_second: 1.0
  # Tamaño de ráfaga permitida.
  rate_limit_burst: 3

  # --- LISTA NEGRA (SHORT-CIRCUIT) ---
  # IPs o rangos CIDR que serán descartados INSTANTÁNEAMENTE.
  # Esto ocurre antes de cualquier cálculo criptográfico, ahorrando CPU.
  # deny_ips:
  #   - "192.168.1.55"      # IP única
  #   - "10.0.0.0/8"        # Rango completo
  #   - "2001:db8::/32"     # IPv6 compatible

# ------------------------------------------------------------------------------
# 6. HOOKS GLOBALES (EVENT DRIVEN)
# ------------------------------------------------------------------------------
# Scripts externos que se ejecutan en respuesta a eventos del sistema.
# Reciben contexto mediante variables de entorno:
# GK_USER, GK_IP, GK_ACTION, GK_STATUS, GK_STAGE, GK_PARAM_NOMBRE.
# Los nombres y valores de params se validan antes de ejecutar cualquier hook.
# "otp" está reservado para 2FA y no se exporta como GK_PARAM_OTP.
# En scripts shell, cite siempre "$GK_PARAM_NOMBRE" y no use eval.
#
# hooks:
#   # Se ejecuta ANTES de cualquier acción. Si devuelve exit code != 0, cancela todo.
#   # Útil para auditoría centralizada o validaciones extra.
#   pre_execute: "/usr/local/bin/gk_global_audit.sh"
#
#   # Se ejecuta tras el éxito del comando principal.
#   on_success: "/usr/local/bin/gk_notify_slack.sh"
#
#   # Se ejecuta si el comando falla o hace timeout.
#   on_error: "/usr/local/bin/gk_alert_admin.sh"
#
#   # Se ejecuta tras completar una reversión (ej. cerrar puerto).
#   on_revert: "/usr/local/bin/gk_notify_revert.sh"

# ------------------------------------------------------------------------------
# 7. USUARIOS AUTORIZADOS
# ------------------------------------------------------------------------------
users:
  - name: "admin"
    # [OBLIGATORIO] Clave pública Base64 (salida de ghostknock-keygen).
    public_key: "PEGAR_AQUI_CLAVE_PUBLICA_BASE64..."
    
    # [OPCIONAL] Secreto TOTP (Base32) para autenticación de dos factores (2FA).
    # Si se define, el usuario DEBE enviar el código OTP usando -args "otp=123456".
    # Compatible con Google Authenticator, Authy, etc.
    # totp_secret: "JBSWY3DPEHPK3PXP"
    
    # [OBLIGATORIO] Lista de IDs de acciones que este usuario puede solicitar.
    actions: ["open-ssh", "restart-web", "full-update"]
    
    # [OPCIONAL] Restricción de origen. Solo acepta paquetes de estas IPs/CIDRs.
    # Si se omite, acepta desde cualquier IP.
    source_ips:
      - "192.168.1.0/24"
      - "10.10.10.5"

# ------------------------------------------------------------------------------
# 8. CATÁLOGO DE ACCIONES
# ------------------------------------------------------------------------------
# Define qué comandos se pueden ejecutar.
# Variables disponibles en comandos: {{.SourceIP}}, {{.Params.nombre_parametro}}
# Nombres de params: ^[A-Za-z_][A-Za-z0-9_]{0,63}$
# Valores de params: ^[A-Za-z0-9._][A-Za-z0-9._-]*$ y distintos de ".."
# Use acceso directo {{.Params.nombre}}; no se permiten accesos dinámicos con index.
actions:

  # EJEMPLO 1: Acción básica con reversión
  "open-ssh":
    # Comando principal a ejecutar.
    command: "iptables -I INPUT 1 -p tcp -s {{.SourceIP}} --dport 22 -j ACCEPT"
    
    # Comando para deshacer la acción.
    revert_command: "iptables -D INPUT -p tcp -s {{.SourceIP}} --dport 22 -j ACCEPT"
    
    # Tiempo (segundos) tras el cual se ejecuta revert_command.
    revert_delay_seconds: 300
    
    # Cooldown específico para esta acción (sobrescribe el global).
    cooldown_seconds: 60

  # EJEMPLO 2: Parámetros dinámicos y usuario específico
  "restart-service":
    # Requiere que el cliente envíe: -args "svc=nginx"
    command: "systemctl restart {{.Params.svc}}"
    
    # Usuario del sistema operativo que ejecutará el comando.
    # Si se omite, se ejecuta como root (o el usuario del demonio).
    # run_as_user: "root"
    
    # Tiempo máximo (segundos) antes de matar el proceso si se cuelga.
    timeout_seconds: 15

  # EJEMPLO 3: Parámetros sensibles (Ocultación en Logs)
  "create-user":
    command: "useradd -p $(openssl passwd -1 {{.Params.pass}}) {{.Params.user}}"
    # Estos parámetros aparecerán como "*****" en los logs del sistema.
    sensitive_params: 
      - "pass"

  # EJEMPLO 4: Hooks específicos de acción (Granularidad fina)
  "deploy-app":
    run_as_user: "www-data"
    command: "/var/www/deploy.sh {{.Params.branch}}"
    
    # Se ejecuta SOLO para esta acción, antes del comando principal.
    pre_hook: "/var/www/hooks/check_git_status.sh"
    
    # Se ejecuta tras el éxito de esta acción.
    post_hook: "/var/www/hooks/clear_cache.sh"
    
    # Se ejecuta tras la reversión de esta acción (si tuviera revert_command).
    revert_hook: "/var/www/hooks/cleanup_temp.sh"
