## Ejemplo de Script Router (`router.sh`)

Este script sirve de referencia para validar la implementación. Debe manejar todos los estados posibles.

```bash
#!/bin/bash
# /usr/local/bin/router_notificaciones.sh
# Script centralizado para manejar eventos de GhostKnock

# Variables disponibles:
# GK_USER, GK_ACTION, GK_IP, GK_STAGE, GK_STATUS, GK_ERROR_MSG

# ==============================================================================
# 1. ETAPA PREVIA (Control de Acceso)
# ==============================================================================
if [ "$GK_STAGE" == "global_pre" ]; then
    # Ejemplo: Bloquear ejecuciones fuera de horario laboral (8am - 8pm)
    HORA=$(date +%H)
    if [ "$HORA" -lt 8 ] || [ "$HORA" -gt 20 ]; then
        echo "BLOQUEADO: Intento de acceso fuera de horario ($HORA h)."
        exit 1 # Esto cancela la acción en GhostKnock
    fi
    exit 0 # Permitir
fi

# ==============================================================================
# 2. ETAPA POST-EJECUCIÓN (Notificación)
# ==============================================================================
if [ "$GK_STAGE" == "global_success" ]; then
    MSG="🚀 [SUCCESS] $GK_USER ejecutó '$GK_ACTION' desde $GK_IP"
    # Enviar a Telegram
    curl -s -X POST "https://api.telegram.org/botTOKEN/sendMessage" -d chat_id="12345" -d text="$MSG"
fi

if [ "$GK_STAGE" == "global_error" ]; then
    MSG="⚠️ [ERROR] Fallo al ejecutar '$GK_ACTION' por $GK_USER. Razón: $GK_ERROR_MSG"
    # Registrar en Syslog local con prioridad alta
    logger -p local0.err -t ghostknock_audit "$MSG"
fi

# ==============================================================================
# 3. ETAPA REVERSIÓN (Auditoría de Cierre)
# ==============================================================================
if [ "$GK_STAGE" == "global_revert" ]; then
    if [ "$GK_STATUS" == "success" ]; then
        # Reversión OK (Silenciosa o Log)
        logger -t ghostknock_audit "🔒 [REVERT OK] Cierre automático completado para acción '$GK_ACTION'"
    else
        # Reversión FALLIDA (Crítico: El puerto sigue abierto)
        MSG="🚨 [REVERT FAILED] Atención: Fallo al revertir '$GK_ACTION'. Revisar sistema manualmente. Error: $GK_ERROR_MSG"
        curl -s -X POST "https://api.telegram.org/botTOKEN/sendMessage" -d chat_id="ADMIN_ID" -d text="$MSG"
    fi
fi
```
